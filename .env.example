# =============================================================================
# Mastodon on Railway — copy these into Railway Variables.
# Do not commit real secrets. Use the service names below as-is if you name
# your services: Web, Sidekiq, Streaming, Postgres, Redis.
# =============================================================================

# --- Identity (set AFTER you generate Railway domains, then redeploy) ----------
# Use the Web service hostname only. No https:// prefix.
LOCAL_DOMAIN=${{Web.RAILWAY_PUBLIC_DOMAIN}}
WEB_DOMAIN=${{Web.RAILWAY_PUBLIC_DOMAIN}}
STREAMING_PUBLIC_DOMAIN=${{Streaming.RAILWAY_PUBLIC_DOMAIN}}
STREAMING_API_BASE_URL=wss://${{Streaming.RAILWAY_PUBLIC_DOMAIN}}
LOCAL_HTTPS=true

# --- Core runtime -------------------------------------------------------------
RAILS_ENV=production
NODE_ENV=production
RAILS_SERVE_STATIC_FILES=true
RAILS_LOG_TO_STDOUT=true
ES_ENABLED=false
BIND=0.0.0.0

# --- Database / Redis (private network) ---------------------------------------
DATABASE_URL=${{Postgres.DATABASE_URL}}
REDIS_URL=${{Redis.REDIS_URL}}

# --- Admin created on first web boot ------------------------------------------
ADMIN_USERNAME=admin
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me-to-a-long-password

# --- Secrets (auto-generated onto the media volume on first boot) -------------
# After first successful web deploy, copy the block printed in Web logs into
# shared Railway Variables so they survive a volume rebuild.
# SECRET_KEY_BASE=
# OTP_SECRET=
# VAPID_PRIVATE_KEY=
# VAPID_PUBLIC_KEY=
# ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=
# ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=
# ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=

# --- SMTP (needed for extra signups / password reset) -------------------------
# SMTP_SERVER=smtp.resend.com
# SMTP_PORT=587
# SMTP_LOGIN=resend
# SMTP_PASSWORD=
# SMTP_FROM_ADDRESS=noreply@example.com
# SMTP_AUTH_METHOD=plain
# SMTP_ENABLE_STARTTLS=auto
# SMTP_OPENSSL_VERIFY_MODE=peer

# --- Optional S3-compatible media (recommended once you federate) -------------
# S3_ENABLED=true
# S3_PROTOCOL=https
# S3_REGION=auto
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_BUCKET=mastodon-media
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# S3_ALIAS_HOST=media.example.com

# --- Tuning -------------------------------------------------------------------
WEB_CONCURRENCY=2
MAX_THREADS=5
SIDEKIQ_CONCURRENCY=5
RAILWAY_RUN_UID=0
